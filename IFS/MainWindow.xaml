<!-- corrigé le 01-01-2019 -->
<Window x:Class="IFS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IFS"
        mc:Ignorable="d"
        Title="Improved F‑Score Calculation Program : EEIC’2019 University of Bejaia"
        Height="600" Width="860" MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <!-- Titre -->
            <TextBlock x:Name="textBlockTitre" FontSize="18" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                       Text="Improved F‑Score Calculation Program : EEIC’2019 University of Bejaia"/>

            <!-- Article de référence de la méthode -->
            <TextBlock x:Name="textBlockReference" Margin="0,10,0,0" FontStyle="Italic" TextAlignment="Center" TextWrapping="Wrap"
                       Text="Reference paper for the method: L’haddad, S., &amp; Kemmouche, A. Hyperspectral Feature Selection using Improved F‑Score Technique (2019)."/>

            <!-- Sélection de l'image multibande -->
            <TextBlock Margin="0,28,0,6" TextWrapping="Wrap"
                       Text="Select a multiband image: either select a single image file containing all the bands (.hdr), or select the set of individual band files that form the multiband image"/>
            <DockPanel>
                <Button x:Name="buttonMultibande" DockPanel.Dock="Right" Content="Browse..." Width="100" Height="26" Margin="10,0,0,0"
                        Click="buttonMultibande_Click"/>
                <TextBox x:Name="textBoxMultibande" IsReadOnly="True" Height="26" VerticalContentAlignment="Center"/>
            </DockPanel>

            <!-- Sélection de l'image classée -->
            <TextBlock Margin="0,20,0,6" TextWrapping="Wrap" Text="Select label image (classified image)"/>
            <DockPanel>
                <Button x:Name="buttonEtiquettes" DockPanel.Dock="Right" Content="Browse..." Width="100" Height="26" Margin="10,0,0,0"
                        Click="buttonEtiquettes_Click"/>
                <TextBox x:Name="textBoxEtiquettes" IsReadOnly="True" Height="26" VerticalContentAlignment="Center"/>
            </DockPanel>

            <!-- Exécution -->
            <Button x:Name="buttonExecuter" Content="Execute" Width="130" Height="30" Margin="0,24,0,0" HorizontalAlignment="Center"
                    Click="buttonExecuter_Click"/>
        </StackPanel>

        <!-- Scores obtenus -->
        <TextBox x:Name="textBoxResultat" Grid.Row="1" Margin="0,16,0,0" IsReadOnly="True" TextWrapping="NoWrap"
                 FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    </Grid>
</Window>
